diff --git a/ios/StarshipTouchControls.mm b/ios/StarshipTouchControls.mm
new file mode 100644
index 00000000..575c93d6
--- /dev/null
+++ b/ios/StarshipTouchControls.mm
@@ -0,0 +1,1428 @@
+#import <UIKit/UIKit.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <SDL.h>
+
+#include "StarshipTouchControls.h"
+
+static BOOL sTouchControlsDesired;
+static BOOL sTouchAnalogDesired = YES;
+static BOOL sCustomTouchLayoutEnabled;
+static BOOL sLayoutEditorRequested;
+static BOOL sLayoutEditorActive;
+static std::atomic_bool sTouchControlsMenuVisible(false);
+static std::atomic_bool sControllerReconcileQueued(false);
+static SDL_Joystick* sVirtualJoystick;
+static SDL_JoystickID sVirtualJoystickInstance = -1;
+static std::array<int, SDL_NUM_SCANCODES> sControlPressCounts = {};
+static const NSInteger kTouchLayoutStorageVersion = 2;
+static void StarshipPad_ApplyTouchControlsState(void);
+static void StarshipPad_ReleaseVisibleInputs(void);
+
+static void StarshipPad_PushKey(SDL_Scancode scancode, BOOL pressed) {
+    SDL_Event event = {};
+    event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.timestamp = SDL_GetTicks();
+    event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+    event.key.repeat = 0;
+    event.key.keysym.scancode = scancode;
+    event.key.keysym.sym = SDL_GetKeyFromScancode(scancode);
+    SDL_Window* window = SDL_GetKeyboardFocus();
+    if (window != nullptr) {
+        event.key.windowID = SDL_GetWindowID(window);
+    }
+    SDL_PushEvent(&event);
+}
+
+static BOOL StarshipPad_PushVirtualControl(SDL_Scancode scancode, BOOL pressed) {
+    if (!sTouchAnalogDesired || sVirtualJoystick == nullptr) {
+        return NO;
+    }
+
+    SDL_GameControllerButton button = SDL_CONTROLLER_BUTTON_INVALID;
+    SDL_GameControllerAxis axis = SDL_CONTROLLER_AXIS_INVALID;
+    Sint16 axisValue = 0;
+    switch (scancode) {
+        case SDL_SCANCODE_X:
+            button = SDL_CONTROLLER_BUTTON_A;
+            break;
+        case SDL_SCANCODE_C:
+            button = SDL_CONTROLLER_BUTTON_X;
+            break;
+        case SDL_SCANCODE_Z:
+            button = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+            break;
+        case SDL_SCANCODE_R:
+            button = SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+            break;
+        case SDL_SCANCODE_SPACE:
+            button = SDL_CONTROLLER_BUTTON_START;
+            break;
+        case SDL_SCANCODE_LEFT:
+            button = SDL_CONTROLLER_BUTTON_Y;
+            break;
+        case SDL_SCANCODE_DOWN:
+            button = SDL_CONTROLLER_BUTTON_B;
+            break;
+        case SDL_SCANCODE_UP:
+            axis = SDL_CONTROLLER_AXIS_RIGHTY;
+            axisValue = pressed ? SDL_JOYSTICK_AXIS_MIN : 0;
+            break;
+        case SDL_SCANCODE_RIGHT:
+            axis = SDL_CONTROLLER_AXIS_RIGHTX;
+            axisValue = pressed ? SDL_JOYSTICK_AXIS_MAX : 0;
+            break;
+        case SDL_SCANCODE_T:
+            button = SDL_CONTROLLER_BUTTON_DPAD_UP;
+            break;
+        case SDL_SCANCODE_G:
+            button = SDL_CONTROLLER_BUTTON_DPAD_DOWN;
+            break;
+        case SDL_SCANCODE_F:
+            button = SDL_CONTROLLER_BUTTON_DPAD_LEFT;
+            break;
+        case SDL_SCANCODE_H:
+            button = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+            break;
+        default:
+            return NO;
+    }
+
+    if (button != SDL_CONTROLLER_BUTTON_INVALID) {
+        return SDL_JoystickSetVirtualButton(sVirtualJoystick, button,
+                                            pressed ? SDL_PRESSED : SDL_RELEASED) == 0;
+    }
+    return SDL_JoystickSetVirtualAxis(sVirtualJoystick, axis, axisValue) == 0;
+}
+
+static void StarshipPad_PushControl(SDL_Scancode scancode, BOOL pressed) {
+    int& count = sControlPressCounts[scancode];
+    const BOOL wasPressed = count > 0;
+    count = pressed ? count + 1 : MAX(0, count - 1);
+    const BOOL isPressed = count > 0;
+    if (wasPressed == isPressed) {
+        return;
+    }
+    if (!StarshipPad_PushVirtualControl(scancode, isPressed)) {
+        StarshipPad_PushKey(scancode, isPressed);
+    }
+}
+
+static int StarshipPad_FindVirtualDeviceIndex(void) {
+    for (int index = 0; index < SDL_NumJoysticks(); index++) {
+        if (SDL_JoystickGetDeviceInstanceID(index) == sVirtualJoystickInstance) {
+            return index;
+        }
+    }
+    return -1;
+}
+
+static void StarshipPad_DetachVirtualController(void) {
+    if (sVirtualJoystick == nullptr) {
+        return;
+    }
+
+    const int deviceIndex = StarshipPad_FindVirtualDeviceIndex();
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTX, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTY, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_RIGHTX, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_RIGHTY, 0);
+    SDL_JoystickClose(sVirtualJoystick);
+    sVirtualJoystick = nullptr;
+    sVirtualJoystickInstance = -1;
+    if (deviceIndex >= 0) {
+        SDL_JoystickDetachVirtual(deviceIndex);
+    }
+    SDL_Log("StarshipPad analog touch controller detached");
+}
+
+static void StarshipPad_AttachVirtualController(void) {
+    if (sVirtualJoystick != nullptr) {
+        return;
+    }
+
+    const int deviceIndex =
+        SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER,
+                                  SDL_CONTROLLER_AXIS_MAX, SDL_CONTROLLER_BUTTON_MAX, 0);
+    if (deviceIndex < 0 || SDL_IsGameController(deviceIndex) != SDL_TRUE) {
+        if (deviceIndex >= 0) {
+            SDL_JoystickDetachVirtual(deviceIndex);
+        }
+        SDL_Log("StarshipPad analog touch controller unavailable: %s", SDL_GetError());
+        return;
+    }
+
+    sVirtualJoystick = SDL_JoystickOpen(deviceIndex);
+    if (sVirtualJoystick == nullptr) {
+        SDL_JoystickDetachVirtual(deviceIndex);
+        SDL_Log("StarshipPad analog touch controller open failed: %s", SDL_GetError());
+        return;
+    }
+
+    sVirtualJoystickInstance = SDL_JoystickInstanceID(sVirtualJoystick);
+    SDL_JoystickSetPlayerIndex(sVirtualJoystick, 0);
+    SDL_Log("StarshipPad analog touch controller attached: instance=%d",
+            static_cast<int>(sVirtualJoystickInstance));
+}
+
+static BOOL StarshipPad_HasPhysicalController(void) {
+    for (int index = 0; index < SDL_NumJoysticks(); index++) {
+        if (SDL_JoystickGetDeviceInstanceID(index) != sVirtualJoystickInstance &&
+            SDL_IsGameController(index) == SDL_TRUE) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+static void StarshipPad_ReconcileVirtualController(void) {
+    if (sTouchControlsDesired && sTouchAnalogDesired && !StarshipPad_HasPhysicalController()) {
+        StarshipPad_AttachVirtualController();
+    } else {
+        StarshipPad_DetachVirtualController();
+    }
+}
+
+static int StarshipPad_ControllerDeviceEventWatch(void* userdata, SDL_Event* event) {
+    (void)userdata;
+    if (event->type != SDL_CONTROLLERDEVICEADDED && event->type != SDL_CONTROLLERDEVICEREMOVED &&
+        event->type != SDL_JOYDEVICEADDED && event->type != SDL_JOYDEVICEREMOVED) {
+        return 1;
+    }
+    if (sControllerReconcileQueued.exchange(true)) {
+        return 1;
+    }
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        sControllerReconcileQueued.store(false);
+        StarshipPad_ReleaseVisibleInputs();
+        StarshipPad_ApplyTouchControlsState();
+    });
+    return 1;
+}
+
+static void StarshipPad_InstallControllerDeviceEventWatch(void) {
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        SDL_AddEventWatch(StarshipPad_ControllerDeviceEventWatch, nullptr);
+    });
+}
