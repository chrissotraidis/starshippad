+        state = SetupState::Extracting;
+        statusMessage.clear();
+        extractionFrames = 0;
+
+        extractionTask.emplace(std::async(std::launch::async, [extractor, mainGame, outputPath]() {
+            const auto startedAt = std::chrono::steady_clock::now();
+            ExtractionResult result;
+            result.mainGame = mainGame;
+            result.outputPath = outputPath;
+            result.success = extractor->GenerateOTR() && std::filesystem::is_regular_file(outputPath);
+            result.error = extractor->GetLastError();
+            result.wallMilliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                          std::chrono::steady_clock::now() - startedAt)
+                                          .count();
+            struct rusage usage = {};
