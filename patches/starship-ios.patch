+                state = SetupState::VoicePackInstalled;
+            }
+        }
+
+        if (!window->IsFrameReady()) {
+            SDL_Delay(1);
+            continue;
+        }
+
+        gui->StartDraw();
+        window->StartFrame();
+        window->RunGuiOnly();
+
+        const ImGuiIO& io = ImGui::GetIO();
+        const float setupWidth = std::min(620.0f, io.DisplaySize.x - 40.0f);
+        ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                                ImVec2(0.5f, 0.5f));
+        ImGui::SetNextWindowSize(ImVec2(setupWidth, 0.0f), ImGuiCond_Always);
