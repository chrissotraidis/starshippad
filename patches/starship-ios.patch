+#ifdef __IOS__
+bool GameEngine::RunFirstRunExtraction() {
+    enum class SetupState {
+        AwaitingRom,
+        Extracting,
+        VoicePackInstalled,
+        Error,
+    };
+    struct ExtractionResult {
+        bool success = false;
+        bool mainGame = false;
+        uint64_t wallMilliseconds = 0;
+        long peakResidentBytes = 0;
+        std::string outputPath;
+        std::string error;
+    };
+
+    auto window = std::dynamic_pointer_cast<Fast::Fast3dWindow>(context->GetWindow());
+    auto gui = window->GetGui();
+    SetupState state = SetupState::AwaitingRom;
+    std::string statusMessage;
+    std::optional<std::future<ExtractionResult>> extractionTask;
+    uint64_t extractionFrames = 0;
+
+    const auto beginExtraction = [&]() {
+        const auto roms = GameExtractor::FindRoms(Ship::Context::GetAppDirectoryPath());
+        if (roms.empty()) {
+            statusMessage = "No supported ROM files were found. Copy one into StarshipPad in Files, then try again.";
+            state = SetupState::AwaitingRom;
+            return;
+        }
+
+        std::shared_ptr<GameExtractor> extractor;
+        std::string gameName;
+        for (const auto& romPath : roms) {
+            auto candidate = std::make_shared<GameExtractor>();
+            if (!candidate->LoadGame(romPath)) {
+                continue;
+            }
+            auto validatedGame = candidate->ValidateChecksum();
+            if (validatedGame.has_value()) {
+                extractor = candidate;
+                gameName = validatedGame.value();
+                break;
+            }
+        }
+
+        if (extractor == nullptr) {
+            statusMessage = "A ROM file was found, but its checksum is not supported.";
+            state = SetupState::Error;
+            return;
+        }
+
+        const bool mainGame = extractor->IsMainGame();
+        const std::string outputPath = extractor->GetExpectedOutputPath();
+        SPDLOG_INFO("StarshipPad extraction started: game={}, kind={}, output={}", gameName,
+                    mainGame ? "main" : "voice-pack", std::filesystem::path(outputPath).filename().string());
+        state = SetupState::Extracting;
+        statusMessage.clear();
+        extractionFrames = 0;
+
+        extractionTask.emplace(std::async(std::launch::async, [extractor, mainGame, outputPath]() {
+            const auto startedAt = std::chrono::steady_clock::now();
+            ExtractionResult result;
+            result.mainGame = mainGame;
+            result.outputPath = outputPath;
+            result.success = extractor->GenerateOTR() && std::filesystem::is_regular_file(outputPath);
+            result.error = extractor->GetLastError();
+            result.wallMilliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                          std::chrono::steady_clock::now() - startedAt)
+                                          .count();
+            struct rusage usage = {};
+            if (getrusage(RUSAGE_SELF, &usage) == 0) {
+                result.peakResidentBytes = usage.ru_maxrss;
+            }
+            return result;
+        }));
+    };
+
+    while (window->IsRunning()) {
+        window->HandleEvents();
+
+        if (extractionTask.has_value() &&
+            extractionTask->wait_for(std::chrono::milliseconds(0)) == std::future_status::ready) {
+            ExtractionResult result = extractionTask->get();
+            extractionTask.reset();
+            SPDLOG_INFO("StarshipPad extraction finished: kind={}, success={}, wall_ms={}, peak_rss_bytes={}, output={}",
+                        result.mainGame ? "main" : "voice-pack", result.success, result.wallMilliseconds,
+                        result.peakResidentBytes, std::filesystem::path(result.outputPath).filename().string());
+
+            if (!result.success) {
+                statusMessage = result.error.empty() ? "Torch did not produce the expected archive." : result.error;
+                state = SetupState::Error;
+            } else if (result.mainGame) {
+                return true;
+            } else {
+                statusMessage = "Voice pack installed in Documents/mods. A supported US ROM is still required to run the game.";
+                state = SetupState::VoicePackInstalled;
+            }
+        }
+
+        if (!window->IsFrameReady()) {
+            SDL_Delay(1);
+            continue;
+        }
+
+        gui->StartDraw();
+        window->StartFrame();
+        window->RunGuiOnly();
+
+        const ImGuiIO& io = ImGui::GetIO();
+        const float setupWidth = std::min(620.0f, io.DisplaySize.x - 40.0f);
+        ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                                ImVec2(0.5f, 0.5f));
+        ImGui::SetNextWindowSize(ImVec2(setupWidth, 0.0f), ImGuiCond_Always);
+        ImGui::Begin("StarshipPad Setup", nullptr,
+                     ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize |
+                         ImGuiWindowFlags_NoSavedSettings);
+        ImGui::TextWrapped("StarshipPad extracts assets from your legally acquired Star Fox 64 ROM on this device.");
+        ImGui::Spacing();
+
+        if (state == SetupState::Extracting) {
+            static const char spinner[] = "|/-\\";
+            ImGui::Text("Extracting assets... %c", spinner[(SDL_GetTicks() / 150) % 4]);
+            ImGui::TextWrapped("This can take several minutes. You can leave StarshipPad open while it works.");
+            ImGui::ProgressBar(0.0f, ImVec2(-1.0f, 34.0f), "Working");
+            extractionFrames++;
+            if (extractionFrames % 1800 == 0) {
+                SPDLOG_INFO("StarshipPad extraction UI remains responsive: rendered_frames={}", extractionFrames);
+            }
+        } else {
+            ImGui::TextWrapped("Open Files and copy any supported .z64, .n64, or .v64 file into:");
+            ImGui::Spacing();
+            ImGui::TextUnformatted("On My iPad > StarshipPad");
+            ImGui::Spacing();
+            ImGui::TextWrapped("Return here and choose Rescan. The filename does not matter.");
+            if (!statusMessage.empty()) {
+                ImGui::Spacing();
+                ImGui::TextWrapped("%s", statusMessage.c_str());
+            }
+            ImGui::Spacing();
+            const char* buttonLabel = state == SetupState::Error ? "Try Again" : "Rescan";
+            if (ImGui::Button(buttonLabel, ImVec2(160.0f, 44.0f))) {
+                beginExtraction();
+            }
+        }
+
+        ImGui::End();
+        gui->EndDraw();
+        window->EndFrame();
+        SDL_Delay(1);
+    }
+
+    return false;
+}
+#endif
