+#ifdef __IOS__
+namespace {
+struct VoicePackInstallResult {
+    bool success = false;
+    std::string message;
+};
+
+std::optional<std::future<VoicePackInstallResult>> sVoicePackInstallTask;
+
+void StartVoicePackInstall() {
+    sVoicePackInstallTask.emplace(std::async(std::launch::async, []() {
+        VoicePackInstallResult result;
+        try {
+            auto extractor = std::make_shared<GameExtractor>();
+            if (!extractor->SelectVoicePackFromAppDirectory()) {
+                result.message = extractor->GetLastError();
+                return result;
+            }
+
+            const std::string outputPath = extractor->GetExpectedOutputPath();
+            SPDLOG_INFO("StarshipPad voice-pack installation started: input={}, output={}",
+                        extractor->GetGamePath().filename().string(),
+                        std::filesystem::path(outputPath).filename().string());
+
+            std::error_code error;
+            result.success =
+                extractor->GenerateOTR() && std::filesystem::is_regular_file(outputPath, error);
+            result.message = extractor->GetLastError();
+            if (result.success) {
+                result.message = "Voice-pack assets installed. Restart StarshipPad to use them.";
+            } else if (result.message.empty()) {
+                result.message = "The voice-pack archive could not be created.";
+            }
+
+            SPDLOG_INFO("StarshipPad voice-pack installation finished: success={}, output={}",
+                        result.success, std::filesystem::path(outputPath).filename().string());
+        } catch (const std::exception& exception) {
+            result.message = exception.what();
+            SPDLOG_ERROR("StarshipPad voice-pack installation failed: {}", result.message);
+        }
+        return result;
+    }));
+}
+
+void PollVoicePackInstall() {
+    if (!sVoicePackInstallTask.has_value() ||
+        sVoicePackInstallTask->wait_for(std::chrono::milliseconds(0)) != std::future_status::ready) {
+        return;
+    }
+
+    VoicePackInstallResult result = sVoicePackInstallTask->get();
+    sVoicePackInstallTask.reset();
+    GameEngine::ShowMessage(result.success ? "Success" : "Voice Pack",
+                            result.message.c_str(),
+                            result.success ? SDL_MESSAGEBOX_INFORMATION : SDL_MESSAGEBOX_ERROR);
+}
+} // namespace
+#endif
