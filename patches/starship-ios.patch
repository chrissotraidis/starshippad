+            if (validatedGame.has_value()) {
+                extractor = candidate;
+                gameName = validatedGame.value();
+                break;
+            }
+        }
+
+        if (extractor == nullptr) {
+            statusMessage = "A ROM file was found, but its checksum is not supported.";
+            state = SetupState::Error;
