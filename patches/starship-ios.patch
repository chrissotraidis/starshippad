+bool GameExtractor::LoadGame(const fs::path& path) {
+    this->mGamePath = path;
     std::ifstream file(this->mGamePath, std::ios::binary);
+    if (!file.is_open()) {
+        return false;
+    }
     this->mGameData = std::vector<uint8_t>( std::istreambuf_iterator( file ), {} );
     file.close();
+    this->mGameHash.clear();
+    std::string format = "unknown";
+    if (this->mGameData.size() >= 4) {
+        if (this->mGameData[0] == 0x80 && this->mGameData[1] == 0x37) {
+            format = "z64";
+        } else if (this->mGameData[0] == 0x37 && this->mGameData[1] == 0x80) {
+            format = "v64";
+        } else if (this->mGameData[0] == 0x40 && this->mGameData[1] == 0x12) {
+            format = "n64";
+        }
+    }
+    if (!NormalizeRomByteOrder(this->mGameData)) {
+        return false;
+    }
+    SPDLOG_INFO("ROM import candidate loaded: file={}, format={}", this->mGamePath.filename().string(), format);
     return true;
