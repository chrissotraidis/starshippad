+- (void)layoutSubviews {
+    [super layoutSubviews];
+    UIEdgeInsets safe = self.safeAreaInsets;
+    CGFloat width = CGRectGetWidth(self.bounds);
+    CGFloat height = CGRectGetHeight(self.bounds);
+    CGFloat scale = MAX(0.72, MIN(1.08, height / 650.0));
+    CGFloat edge = 16.0 * scale;
+    CGFloat left = safe.left + edge;
+    CGFloat right = width - safe.right - edge;
+    CGFloat top = safe.top + edge;
+    CGFloat bottom = height - safe.bottom - edge;
+
+    CGFloat stickSize = 150.0 * scale;
+    self.controlStick.frame =
+        CGRectMake(left, bottom - stickSize, stickSize, stickSize);
+
+    CGFloat shoulderWidth = 98.0 * scale;
+    CGFloat shoulderHeight = 48.0 * scale;
+    self.buttonZ.frame = CGRectMake(left, top, shoulderWidth, shoulderHeight);
+    self.buttonR.frame =
+        CGRectMake(right - shoulderWidth, top, shoulderWidth, shoulderHeight);
+
+    CGFloat startWidth = 82.0 * scale;
+    CGFloat startHeight = 38.0 * scale;
+    self.buttonStart.frame =
+        CGRectMake(width * 0.5 - startWidth * 0.5, top, startWidth, startHeight);
+
+    CGFloat dSize = 36.0 * scale;
+    CGFloat dRadius = 31.0 * scale;
+    CGPoint dCenter = CGPointMake(left + 64.0 * scale, height * 0.43);
+    self.dUp.frame =
+        CGRectMake(dCenter.x - dSize * 0.5,
+                   dCenter.y - dRadius - dSize * 0.5, dSize, dSize);
+    self.dDown.frame =
+        CGRectMake(dCenter.x - dSize * 0.5,
+                   dCenter.y + dRadius - dSize * 0.5, dSize, dSize);
+    self.dLeft.frame =
+        CGRectMake(dCenter.x - dRadius - dSize * 0.5,
+                   dCenter.y - dSize * 0.5, dSize, dSize);
+    self.dRight.frame =
+        CGRectMake(dCenter.x + dRadius - dSize * 0.5,
+                   dCenter.y - dSize * 0.5, dSize, dSize);
+
+    CGFloat railWidth = 112.0 * scale;
+    CGFloat railHeight = 43.0 * scale;
+    CGFloat railX = right - railWidth;
+    CGFloat boostY = MAX(top + 70.0 * scale, height * 0.32);
+    self.buttonBoost.frame = CGRectMake(railX, boostY, railWidth, railHeight);
+    self.buttonBrake.frame =
+        CGRectMake(railX, CGRectGetMaxY(self.buttonBoost.frame) + 10.0 * scale,
+                   railWidth, railHeight);
+
+    CGFloat utilityWidth = 52.0 * scale;
+    CGFloat utilityHeight = 38.0 * scale;
+    CGFloat utilityY = CGRectGetMaxY(self.buttonBrake.frame) + 10.0 * scale;
+    self.buttonView.frame =
+        CGRectMake(railX, utilityY, utilityWidth, utilityHeight);
+    self.buttonTalk.frame =
+        CGRectMake(right - utilityWidth, utilityY, utilityWidth, utilityHeight);
+
+    CGFloat faceA = 76.0 * scale;
+    CGFloat faceB = 60.0 * scale;
+    self.buttonA.frame =
+        CGRectMake(right - faceA, bottom - faceA, faceA, faceA);
+    self.buttonB.frame =
+        CGRectMake(CGRectGetMinX(self.buttonA.frame) - faceB - 12.0 * scale,
+                   bottom - faceB + 4.0 * scale, faceB, faceB);
+
+    CGFloat labelSize = 16.0 * scale;
+    for (StarshipPadTouchButton* button in self.buttons) {
+        button.titleLabel.font = [UIFont systemFontOfSize:labelSize weight:UIFontWeightSemibold];
+    }
+    self.buttonA.titleLabel.font =
+        [UIFont systemFontOfSize:22.0 * scale weight:UIFontWeightBold];
+    self.buttonB.titleLabel.font =
+        [UIFont systemFontOfSize:19.0 * scale weight:UIFontWeightBold];
+    for (StarshipPadTouchButton* button in
+         @[ self.dUp, self.dDown, self.dLeft, self.dRight ]) {
+        button.titleLabel.font =
+            [UIFont systemFontOfSize:13.0 * scale weight:UIFontWeightBold];
+    }
+}
+
+- (void)cancelAllInputs {
+    [self.controlStick cancelInput];
+    for (StarshipPadTouchButton* button in self.buttons) {
+        [button cancelInput];
+    }
+}
+
+@end
