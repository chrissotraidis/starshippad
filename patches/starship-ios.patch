diff --git a/ios/StarshipTouchControls.mm b/ios/StarshipTouchControls.mm
new file mode 100644
index 00000000..c6cbf80e
--- /dev/null
+++ b/ios/StarshipTouchControls.mm
@@ -0,0 +1,816 @@
+#import <UIKit/UIKit.h>
+
+#include <atomic>
+#include <SDL.h>
+
+#include "StarshipTouchControls.h"
+
+static BOOL sTouchControlsDesired;
+static BOOL sTouchAnalogDesired = YES;
+static std::atomic_bool sTouchControlsMenuVisible(false);
+static SDL_Joystick* sVirtualJoystick;
+static SDL_JoystickID sVirtualJoystickInstance = -1;
+
+static void StarshipPad_PushKey(SDL_Scancode scancode, BOOL pressed) {
+    SDL_Event event = {};
+    event.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.timestamp = SDL_GetTicks();
+    event.key.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+    event.key.repeat = 0;
+    event.key.keysym.scancode = scancode;
+    event.key.keysym.sym = SDL_GetKeyFromScancode(scancode);
+    SDL_Window* window = SDL_GetKeyboardFocus();
+    if (window != nullptr) {
+        event.key.windowID = SDL_GetWindowID(window);
+    }
+    SDL_PushEvent(&event);
+}
+
+static BOOL StarshipPad_PushVirtualControl(SDL_Scancode scancode, BOOL pressed) {
+    if (!sTouchAnalogDesired || sVirtualJoystick == nullptr) {
+        return NO;
+    }
+
+    SDL_GameControllerButton button = SDL_CONTROLLER_BUTTON_INVALID;
+    SDL_GameControllerAxis axis = SDL_CONTROLLER_AXIS_INVALID;
+    Sint16 axisValue = 0;
+    switch (scancode) {
+        case SDL_SCANCODE_X:
+            button = SDL_CONTROLLER_BUTTON_A;
+            break;
+        case SDL_SCANCODE_C:
+            button = SDL_CONTROLLER_BUTTON_X;
+            break;
+        case SDL_SCANCODE_Z:
+            button = SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+            break;
+        case SDL_SCANCODE_R:
+            button = SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+            break;
+        case SDL_SCANCODE_SPACE:
+            button = SDL_CONTROLLER_BUTTON_START;
+            break;
+        case SDL_SCANCODE_LEFT:
+            button = SDL_CONTROLLER_BUTTON_Y;
+            break;
+        case SDL_SCANCODE_DOWN:
+            button = SDL_CONTROLLER_BUTTON_B;
+            break;
+        case SDL_SCANCODE_UP:
+            axis = SDL_CONTROLLER_AXIS_RIGHTY;
+            axisValue = pressed ? SDL_JOYSTICK_AXIS_MIN : 0;
+            break;
+        case SDL_SCANCODE_RIGHT:
+            axis = SDL_CONTROLLER_AXIS_RIGHTX;
+            axisValue = pressed ? SDL_JOYSTICK_AXIS_MAX : 0;
+            break;
+        case SDL_SCANCODE_T:
+            button = SDL_CONTROLLER_BUTTON_DPAD_UP;
+            break;
+        case SDL_SCANCODE_G:
+            button = SDL_CONTROLLER_BUTTON_DPAD_DOWN;
+            break;
+        case SDL_SCANCODE_F:
+            button = SDL_CONTROLLER_BUTTON_DPAD_LEFT;
+            break;
+        case SDL_SCANCODE_H:
+            button = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+            break;
+        default:
+            return NO;
+    }
+
+    if (button != SDL_CONTROLLER_BUTTON_INVALID) {
+        return SDL_JoystickSetVirtualButton(sVirtualJoystick, button,
+                                            pressed ? SDL_PRESSED : SDL_RELEASED) == 0;
+    }
+    return SDL_JoystickSetVirtualAxis(sVirtualJoystick, axis, axisValue) == 0;
+}
+
+static void StarshipPad_PushControl(SDL_Scancode scancode, BOOL pressed) {
+    if (!StarshipPad_PushVirtualControl(scancode, pressed)) {
+        StarshipPad_PushKey(scancode, pressed);
+    }
+}
+
+static int StarshipPad_FindVirtualDeviceIndex(void) {
+    for (int index = 0; index < SDL_NumJoysticks(); index++) {
+        if (SDL_JoystickGetDeviceInstanceID(index) == sVirtualJoystickInstance) {
+            return index;
+        }
+    }
+    return -1;
+}
+
+static void StarshipPad_DetachVirtualController(void) {
+    if (sVirtualJoystick == nullptr) {
+        return;
+    }
+
+    const int deviceIndex = StarshipPad_FindVirtualDeviceIndex();
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTX, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTY, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_RIGHTX, 0);
+    SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_RIGHTY, 0);
+    SDL_JoystickClose(sVirtualJoystick);
+    sVirtualJoystick = nullptr;
+    sVirtualJoystickInstance = -1;
+    if (deviceIndex >= 0) {
+        SDL_JoystickDetachVirtual(deviceIndex);
+    }
+    SDL_Log("StarshipPad analog touch controller detached");
+}
+
+static void StarshipPad_AttachVirtualController(void) {
+    if (sVirtualJoystick != nullptr) {
+        return;
+    }
+
+    const int deviceIndex =
+        SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER,
+                                  SDL_CONTROLLER_AXIS_MAX, SDL_CONTROLLER_BUTTON_MAX, 0);
+    if (deviceIndex < 0 || SDL_IsGameController(deviceIndex) != SDL_TRUE) {
+        if (deviceIndex >= 0) {
+            SDL_JoystickDetachVirtual(deviceIndex);
+        }
+        SDL_Log("StarshipPad analog touch controller unavailable: %s", SDL_GetError());
+        return;
+    }
+
+    sVirtualJoystick = SDL_JoystickOpen(deviceIndex);
+    if (sVirtualJoystick == nullptr) {
+        SDL_JoystickDetachVirtual(deviceIndex);
+        SDL_Log("StarshipPad analog touch controller open failed: %s", SDL_GetError());
+        return;
+    }
+
+    sVirtualJoystickInstance = SDL_JoystickInstanceID(sVirtualJoystick);
+    SDL_JoystickSetPlayerIndex(sVirtualJoystick, 0);
+    SDL_Log("StarshipPad analog touch controller attached: instance=%d",
+            static_cast<int>(sVirtualJoystickInstance));
+}
+
+static void StarshipPad_ReconcileVirtualController(void) {
+    if (sTouchControlsDesired && sTouchAnalogDesired) {
+        StarshipPad_AttachVirtualController();
+    } else {
+        StarshipPad_DetachVirtualController();
+    }
+}
+
+@interface StarshipPadTouchButton : UIButton
+
+@property(nonatomic) SDL_Scancode scancode;
+@property(nonatomic) BOOL inputPressed;
+@property(nonatomic) uint32_t inputDownTicks;
+@property(nonatomic) NSUInteger pressGeneration;
+@property(nonatomic) BOOL usesPillShape;
+@property(nonatomic, strong) UIColor* idleColor;
+@property(nonatomic, strong) UIColor* pressedColor;
+
+- (instancetype)initWithLabel:(NSString*)label
+                     scancode:(SDL_Scancode)scancode
+                         pill:(BOOL)pill;
+- (void)applyIdleColor:(UIColor*)idleColor
+          pressedColor:(UIColor*)pressedColor;
+- (void)cancelInput;
+
+@end
+
+@implementation StarshipPadTouchButton
+
+- (instancetype)initWithLabel:(NSString*)label
+                     scancode:(SDL_Scancode)scancode
+                         pill:(BOOL)pill {
+    self = [super initWithFrame:CGRectZero];
+    if (self != nil) {
+        self.scancode = scancode;
+        self.usesPillShape = pill;
+        self.multipleTouchEnabled = YES;
+        self.idleColor = [UIColor colorWithWhite:0.04 alpha:0.38];
+        self.pressedColor = [UIColor colorWithWhite:0.78 alpha:0.52];
+        self.backgroundColor = self.idleColor;
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.58].CGColor;
+        self.layer.borderWidth = 2.0;
+        [self setTitle:label forState:UIControlStateNormal];
+        [self setTitleColor:[UIColor colorWithWhite:1.0 alpha:0.94]
+                   forState:UIControlStateNormal];
+        self.titleLabel.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold];
+        self.accessibilityLabel = label;
+        self.accessibilityCustomActions = @[
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Hold"
+                                                       target:self
+                                                     selector:@selector(accessibilityHold:)],
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Double Tap"
+                                                       target:self
+                                                     selector:@selector(accessibilityDoubleTap:)]
+        ];
+
+        [self addTarget:self
+                      action:@selector(inputDown)
+            forControlEvents:UIControlEventTouchDown | UIControlEventTouchDragEnter];
+        [self addTarget:self
+                      action:@selector(inputUp)
+            forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside |
+                             UIControlEventTouchCancel | UIControlEventTouchDragExit];
+    }
+    return self;
+}
+
+- (void)applyIdleColor:(UIColor*)idleColor
+          pressedColor:(UIColor*)pressedColor {
+    self.idleColor = idleColor;
+    self.pressedColor = pressedColor;
+    self.backgroundColor = self.inputPressed ? pressedColor : idleColor;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius =
+        self.usesPillShape ? CGRectGetHeight(self.bounds) * 0.48
+                           : MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.5;
+}
+
+- (void)inputDown {
+    if (self.inputPressed) {
+        return;
+    }
+    self.pressGeneration += 1;
+    self.inputDownTicks = SDL_GetTicks();
+    self.inputPressed = YES;
+    self.backgroundColor = self.pressedColor;
+    StarshipPad_PushControl(self.scancode, YES);
+}
+
+- (void)finishInputUp {
+    if (!self.inputPressed) {
+        return;
+    }
+    self.inputPressed = NO;
+    self.backgroundColor = self.idleColor;
+    StarshipPad_PushControl(self.scancode, NO);
+}
+
+- (void)inputUp {
+    if (!self.inputPressed) {
+        return;
+    }
+
+    static const uint32_t minimumPressMilliseconds = 80;
+    const uint32_t elapsed = SDL_GetTicks() - self.inputDownTicks;
+    if (elapsed >= minimumPressMilliseconds) {
+        [self finishInputUp];
+        return;
+    }
+
+    const NSUInteger generation = self.pressGeneration;
+    const uint32_t remaining = minimumPressMilliseconds - elapsed;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(remaining * NSEC_PER_MSEC)),
+                   dispatch_get_main_queue(), ^{
+                       if (self.pressGeneration == generation) {
+                           [self finishInputUp];
+                       }
+                   });
+}
+
+- (BOOL)accessibilityActivate {
+    if (!self.enabled) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (BOOL)accessibilityHold:(UIAccessibilityCustomAction*)action {
+    if (!self.enabled) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (BOOL)accessibilityDoubleTap:(UIAccessibilityCustomAction*)action {
+    if (!self.enabled) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.20 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputDown];
+                   });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.30 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (void)cancelInput {
+    self.pressGeneration += 1;
+    [self finishInputUp];
+}
+
+@end
+
+@interface StarshipPadTouchStick : UIView
+
+@property(nonatomic, strong) UIView* knob;
+@property(nonatomic) BOOL upPressed;
+@property(nonatomic) BOOL downPressed;
+@property(nonatomic) BOOL leftPressed;
+@property(nonatomic) BOOL rightPressed;
+@property(nonatomic) NSUInteger directionGeneration;
+
+- (void)cancelInput;
+
+@end
+
+@implementation StarshipPadTouchStick
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    if (self != nil) {
+        self.multipleTouchEnabled = NO;
+        self.backgroundColor = [UIColor colorWithWhite:0.04 alpha:0.30];
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.42].CGColor;
+        self.layer.borderWidth = 2.0;
+        self.isAccessibilityElement = YES;
+        self.accessibilityLabel = @"Control Stick";
+        self.accessibilityCustomActions = @[
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Hold Up"
+                                                       target:self
+                                                     selector:@selector(accessibilityHoldUp:)],
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Hold Down"
+                                                       target:self
+                                                     selector:@selector(accessibilityHoldDown:)],
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Hold Left"
+                                                       target:self
+                                                     selector:@selector(accessibilityHoldLeft:)],
+            [[UIAccessibilityCustomAction alloc] initWithName:@"Hold Right"
+                                                       target:self
+                                                     selector:@selector(accessibilityHoldRight:)]
+        ];
+
+        self.knob = [[UIView alloc] initWithFrame:CGRectZero];
+        self.knob.userInteractionEnabled = NO;
+        self.knob.backgroundColor =
+            [UIColor colorWithRed:0.24 green:0.62 blue:0.92 alpha:0.72];
+        self.knob.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.62].CGColor;
+        self.knob.layer.borderWidth = 2.0;
+        [self addSubview:self.knob];
+    }
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.5;
+    CGFloat knobSize = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.43;
+    self.knob.bounds = CGRectMake(0.0, 0.0, knobSize, knobSize);
+    if (!self.upPressed && !self.downPressed && !self.leftPressed && !self.rightPressed) {
+        self.knob.center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+    }
+    self.knob.layer.cornerRadius = knobSize * 0.5;
+}
+
+- (void)setScancode:(SDL_Scancode)scancode pressed:(BOOL)pressed state:(BOOL*)state {
+    if (*state == pressed) {
+        return;
+    }
+    *state = pressed;
+    StarshipPad_PushKey(scancode, pressed);
+}
+
+- (void)updateForPoint:(CGPoint)point {
+    CGPoint center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+    CGFloat radius = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.34;
+    CGFloat dx = point.x - center.x;
+    CGFloat dy = point.y - center.y;
+    CGFloat distance = hypot(dx, dy);
+    if (distance > radius && distance > 0.0) {
+        dx = dx / distance * radius;
+        dy = dy / distance * radius;
+    }
+    self.knob.center = CGPointMake(center.x + dx, center.y + dy);
+
+    if (sTouchAnalogDesired && sVirtualJoystick != nullptr) {
+        const Sint16 axisX =
+            static_cast<Sint16>(lrint((dx / radius) * SDL_JOYSTICK_AXIS_MAX));
+        const Sint16 axisY =
+            static_cast<Sint16>(lrint((dy / radius) * SDL_JOYSTICK_AXIS_MAX));
+        SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTX, axisX);
+        SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTY, axisY);
+        [self setScancode:SDL_SCANCODE_W pressed:NO state:&_upPressed];
+        [self setScancode:SDL_SCANCODE_S pressed:NO state:&_downPressed];
+        [self setScancode:SDL_SCANCODE_A pressed:NO state:&_leftPressed];
+        [self setScancode:SDL_SCANCODE_D pressed:NO state:&_rightPressed];
+        return;
+    }
+
+    CGFloat threshold = radius * 0.30;
+    [self setScancode:SDL_SCANCODE_W pressed:dy < -threshold state:&_upPressed];
+    [self setScancode:SDL_SCANCODE_S pressed:dy > threshold state:&_downPressed];
+    [self setScancode:SDL_SCANCODE_A pressed:dx < -threshold state:&_leftPressed];
+    [self setScancode:SDL_SCANCODE_D pressed:dx > threshold state:&_rightPressed];
+}
+
+- (BOOL)holdDirectionX:(CGFloat)x y:(CGFloat)y {
+    self.directionGeneration += 1;
+    const NSUInteger generation = self.directionGeneration;
+    CGPoint center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+    CGFloat radius = MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.34;
+    [self updateForPoint:CGPointMake(center.x + x * radius, center.y + y * radius)];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       if (self.directionGeneration == generation) {
+                           [self cancelInput];
+                       }
+                   });
+    return YES;
+}
+
+- (BOOL)accessibilityHoldUp:(UIAccessibilityCustomAction*)action {
+    return [self holdDirectionX:0.0 y:-1.0];
+}
+
+- (BOOL)accessibilityHoldDown:(UIAccessibilityCustomAction*)action {
+    return [self holdDirectionX:0.0 y:1.0];
+}
+
+- (BOOL)accessibilityHoldLeft:(UIAccessibilityCustomAction*)action {
+    return [self holdDirectionX:-1.0 y:0.0];
+}
+
+- (BOOL)accessibilityHoldRight:(UIAccessibilityCustomAction*)action {
+    return [self holdDirectionX:1.0 y:0.0];
+}
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    UITouch* touch = touches.anyObject;
+    if (touch != nil) {
+        [self updateForPoint:[touch locationInView:self]];
+    }
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    UITouch* touch = touches.anyObject;
+    if (touch != nil) {
+        [self updateForPoint:[touch locationInView:self]];
+    }
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    [self cancelInput];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event {
+    [self cancelInput];
+}
+
+- (void)cancelInput {
+    self.directionGeneration += 1;
+    [self setScancode:SDL_SCANCODE_W pressed:NO state:&_upPressed];
+    [self setScancode:SDL_SCANCODE_S pressed:NO state:&_downPressed];
+    [self setScancode:SDL_SCANCODE_A pressed:NO state:&_leftPressed];
+    [self setScancode:SDL_SCANCODE_D pressed:NO state:&_rightPressed];
+    if (sVirtualJoystick != nullptr) {
+        SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTX, 0);
+        SDL_JoystickSetVirtualAxis(sVirtualJoystick, SDL_CONTROLLER_AXIS_LEFTY, 0);
+    }
+    self.knob.center = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+}
+
+@end
+
