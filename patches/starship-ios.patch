+#pragma once
+
+#include <string_view>
+
+namespace StarshipPad {
+
+enum class RomArchiveRoute {
+    Unsupported,
+    Main,
+    JapaneseVoice,
+    EuropeanVoice,
+    ChineseVoice,
+};
+
+constexpr RomArchiveRoute GetRomArchiveRoute(std::string_view hash) {
+    if (hash == "d8b1088520f7c5f81433292a9258c1184afa1457" ||
+        hash == "63b69f0ef36306257481afc250f9bc304c7162b2" ||
+        hash == "09f0d105f476b00efa5303a3ebc42e60a7753b7a" ||
+        hash == "f7475fb11e7e6830f82883412638e8390791ab87") {
+        return RomArchiveRoute::Main;
+    }
+    if (hash == "9bd71afbecf4d0a43146e4e7a893395e19bf3220" ||
+        hash == "d064229a32cc05ab85e2381ce07744eb3ffaf530") {
+        return RomArchiveRoute::JapaneseVoice;
+    }
+    if (hash == "05b307b8804f992af1a1e2fbafbd588501fdf799" ||
+        hash == "09f5d5c14219fc77a36c5a6ad5e63f7abd8b3385" ||
+        hash == "e6dad7523ff8f83fad6fbdb59d472b4f76340c2b") {
+        return RomArchiveRoute::EuropeanVoice;
+    }
+    if (hash == "c8a10699dea52f4bb2e2311935c1376dfb352e7a" ||
+        hash == "3a05aba5549fa71e8b16a0c6e2c8481b070818a9") {
+        return RomArchiveRoute::ChineseVoice;
+    }
+    return RomArchiveRoute::Unsupported;
+}
+
+constexpr std::string_view GetRomArchiveRelativePath(RomArchiveRoute route) {
+    switch (route) {
+        case RomArchiveRoute::Main:
+            return "sf64.o2r";
+        case RomArchiveRoute::JapaneseVoice:
+            return "mods/sf64jp.o2r";
+        case RomArchiveRoute::EuropeanVoice:
+            return "mods/sf64eu.o2r";
+        case RomArchiveRoute::ChineseVoice:
+            return "mods/sf64cn.o2r";
+        case RomArchiveRoute::Unsupported:
+            return {};
+    }
+    return {};
+}
+
