+        if (state == SetupState::Extracting) {
+            static const char spinner[] = "|/-\\";
+            ImGui::Text("Extracting assets... %c", spinner[(SDL_GetTicks() / 150) % 4]);
+            ImGui::TextWrapped("This can take several minutes. You can leave StarshipPad open while it works.");
+            ImGui::ProgressBar(0.0f, ImVec2(-1.0f, 34.0f), "Working");
+            extractionFrames++;
+            if (extractionFrames % 1800 == 0) {
