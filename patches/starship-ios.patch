+static void StarshipPad_InstallMenuButton(UIWindow* window) {
+    if (sMenuButton == nil) {
+        sMenuButton =
+            [[StarshipPadTouchButton alloc] initWithLabel:@"•••"
+                                                scancode:SDL_SCANCODE_F1
+                                                    pill:NO];
+        sMenuButton.accessibilityLabel = @"Menu";
+        sMenuButton.titleLabel.font =
+            [UIFont systemFontOfSize:15.0 weight:UIFontWeightSemibold];
+        [sMenuButton
+            applyIdleColor:[UIColor colorWithWhite:0.04 alpha:0.42]
+              pressedColor:[UIColor colorWithWhite:0.72 alpha:0.62]];
+        sMenuButton.autoresizingMask =
+            UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleBottomMargin;
+    }
+
+    const CGFloat size = 44.0;
+    const UIEdgeInsets safe = window.safeAreaInsets;
+    const BOOL compact = CGRectGetHeight(window.bounds) < 560.0;
+    const CGFloat rightInset = compact ? MAX(8.0, safe.right * 0.35) : safe.right + 8.0;
+    const CGFloat topInset = compact ? 16.0 : 52.0;
+    sMenuButton.frame =
+        CGRectMake(CGRectGetWidth(window.bounds) - rightInset - size,
+                   safe.top + topInset, size, size);
+    if (sMenuButton.superview != window) {
+        [sMenuButton removeFromSuperview];
+        [window addSubview:sMenuButton];
+    }
+    sMenuButton.hidden = sLayoutEditorActive;
+    [window bringSubviewToFront:sMenuButton];
+}
+
+static void StarshipPad_ReleaseVisibleInputs(void) {
+    [sTouchOverlay cancelAllInputs];
+    [sMenuButton cancelInput];
+}
+
+static void StarshipPad_ApplyTouchControlsState(void) {
+    StarshipPad_InstallControllerDeviceEventWatch();
+    StarshipPad_InstallLifecycleObservers();
+    StarshipPad_ReconcileVirtualController();
+
+    UIWindow* window = StarshipPad_ActiveWindow();
+    if (window == nil) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+                           StarshipPad_ApplyTouchControlsState();
+                       });
+        return;
+    }
+
+    StarshipPad_InstallMenuButton(window);
+    if (!sTouchControlsDesired || sTouchControlsMenuVisible.load()) {
+        [sTouchOverlay endLayoutEditing];
+        StarshipPad_ReleaseVisibleInputs();
+        [sTouchOverlay removeFromSuperview];
+        sTouchOverlay = nil;
+        return;
+    }
+
+    if (sTouchOverlay == nil) {
+        sTouchOverlay = [[StarshipPadTouchOverlay alloc] initWithFrame:window.bounds];
+        [sTouchOverlay setCustomizableControlsEnabled:sCustomTouchLayoutEnabled];
+        sTouchOverlay.autoresizingMask =
+            UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    }
+    [sTouchOverlay setCustomizableControlsEnabled:sCustomTouchLayoutEnabled];
+    if (sTouchOverlay.superview != window) {
+        [sTouchOverlay removeFromSuperview];
+        sTouchOverlay.frame = window.bounds;
+        [window addSubview:sTouchOverlay];
+    }
+    [sTouchOverlay setNeedsLayout];
+    [window bringSubviewToFront:sTouchOverlay];
+    [window bringSubviewToFront:sMenuButton];
+    if (sLayoutEditorRequested && sCustomTouchLayoutEnabled) {
+        sLayoutEditorRequested = NO;
+        [sTouchOverlay beginLayoutEditing];
+    }
+}
+
+int StarshipPad_TouchControlsAvailable(void) {
+    return 1;
+}
+
+float StarshipPad_GetSafeAreaLeft(void) {
+    UIWindow* window = StarshipPad_ActiveWindow();
+    return window == nil ? 0.0f : static_cast<float>(window.safeAreaInsets.left);
+}
+
+void StarshipPad_SetTouchControlsEnabled(int enabled) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [sTouchOverlay cancelAllInputs];
+        sTouchControlsDesired = enabled != 0;
+        StarshipPad_ApplyTouchControlsState();
+    });
+}
+
+void StarshipPad_SetTouchAnalogEnabled(int enabled) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [sTouchOverlay cancelAllInputs];
+        sTouchAnalogDesired = enabled != 0;
+        StarshipPad_ApplyTouchControlsState();
+    });
+}
+
+void StarshipPad_SetCustomTouchLayoutEnabled(int enabled) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        StarshipPad_ReleaseVisibleInputs();
+        sCustomTouchLayoutEnabled = enabled != 0;
+        if (!sCustomTouchLayoutEnabled) {
+            sLayoutEditorRequested = NO;
+        }
+        [sTouchOverlay setCustomizableControlsEnabled:sCustomTouchLayoutEnabled];
+        StarshipPad_ApplyTouchControlsState();
+        SDL_Log("StarshipPad experimental custom touch layout %s",
+                sCustomTouchLayoutEnabled ? "enabled" : "disabled");
+    });
+}
+
+void StarshipPad_BeginTouchLayoutEditing(void) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (!sCustomTouchLayoutEnabled || !sTouchControlsDesired) {
+            SDL_Log("StarshipPad layout editor requires experimental custom touch controls");
+            return;
+        }
+        sLayoutEditorRequested = YES;
+        if (sTouchControlsMenuVisible.load()) {
+            StarshipPad_PushKey(SDL_SCANCODE_F1, YES);
+            StarshipPad_PushKey(SDL_SCANCODE_F1, NO);
+        } else {
+            StarshipPad_ApplyTouchControlsState();
+        }
+    });
+}
+
+void StarshipPad_SetTouchControlsMenuVisible(int visible) {
+    const bool menuVisible = visible != 0;
+    if (sTouchControlsMenuVisible.exchange(menuVisible) == menuVisible) {
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        StarshipPad_ApplyTouchControlsState();
+    });
+}
