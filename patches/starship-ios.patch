+@interface StarshipPadTouchButton : UIButton
+
+@property(nonatomic) SDL_Scancode scancode;
+@property(nonatomic) BOOL inputPressed;
+@property(nonatomic) BOOL releasePending;
+@property(nonatomic) uint32_t inputDownTicks;
+@property(nonatomic) NSUInteger pressGeneration;
+@property(nonatomic) BOOL usesPillShape;
+@property(nonatomic) BOOL layoutEditing;
+@property(nonatomic, strong) UIColor* idleColor;
+@property(nonatomic, strong) UIColor* pressedColor;
+
+- (instancetype)initWithLabel:(NSString*)label
+                     scancode:(SDL_Scancode)scancode
+                         pill:(BOOL)pill;
+- (void)applyIdleColor:(UIColor*)idleColor
+          pressedColor:(UIColor*)pressedColor;
+- (void)configureAccessibilityHold:(BOOL)hold doubleTap:(BOOL)doubleTap;
+- (void)cancelInput;
+
+@end
+
+@implementation StarshipPadTouchButton
+
+- (instancetype)initWithLabel:(NSString*)label
+                     scancode:(SDL_Scancode)scancode
+                         pill:(BOOL)pill {
+    self = [super initWithFrame:CGRectZero];
+    if (self != nil) {
+        self.scancode = scancode;
+        self.usesPillShape = pill;
+        self.multipleTouchEnabled = YES;
+        self.idleColor = [UIColor colorWithWhite:0.04 alpha:0.38];
+        self.pressedColor = [UIColor colorWithWhite:0.78 alpha:0.52];
+        self.backgroundColor = self.idleColor;
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.58].CGColor;
+        self.layer.borderWidth = 2.0;
+        [self setTitle:label forState:UIControlStateNormal];
+        [self setTitleColor:[UIColor colorWithWhite:1.0 alpha:0.94]
+                   forState:UIControlStateNormal];
+        self.titleLabel.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold];
+        self.accessibilityLabel = label;
+
+        [self addTarget:self
+                      action:@selector(inputDown)
+            forControlEvents:UIControlEventTouchDown | UIControlEventTouchDragEnter];
+        [self addTarget:self
+                      action:@selector(inputUp)
+            forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside |
+                             UIControlEventTouchCancel | UIControlEventTouchDragExit];
+    }
+    return self;
+}
+
+- (void)applyIdleColor:(UIColor*)idleColor
+          pressedColor:(UIColor*)pressedColor {
+    self.idleColor = idleColor;
+    self.pressedColor = pressedColor;
+    self.backgroundColor = self.inputPressed ? pressedColor : idleColor;
+}
+
+- (void)configureAccessibilityHold:(BOOL)hold doubleTap:(BOOL)doubleTap {
+    NSMutableArray<UIAccessibilityCustomAction*>* actions = [NSMutableArray array];
+    if (hold) {
+        [actions addObject:[[UIAccessibilityCustomAction alloc] initWithName:@"Hold"
+                                                                      target:self
+                                                                    selector:@selector(accessibilityHold:)]];
+    }
+    if (doubleTap) {
+        [actions addObject:[[UIAccessibilityCustomAction alloc] initWithName:@"Double Tap"
+                                                                      target:self
+                                                                    selector:@selector(accessibilityDoubleTap:)]];
+    }
+    self.accessibilityCustomActions = actions;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius =
+        self.usesPillShape ? CGRectGetHeight(self.bounds) * 0.48
+                           : MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.5;
+}
+
+- (void)inputDown {
+    if (self.layoutEditing) {
+        return;
+    }
+    if (self.inputPressed) {
+        if (!self.releasePending) {
+            return;
+        }
+        self.pressGeneration += 1;
+        [self finishInputUp];
+    }
+    self.pressGeneration += 1;
+    self.inputDownTicks = SDL_GetTicks();
+    self.inputPressed = YES;
+    self.releasePending = NO;
+    self.backgroundColor = self.pressedColor;
+    StarshipPad_PushControl(self.scancode, YES);
+}
+
+- (void)finishInputUp {
+    if (!self.inputPressed) {
+        return;
+    }
+    self.inputPressed = NO;
+    self.releasePending = NO;
+    self.backgroundColor = self.idleColor;
+    StarshipPad_PushControl(self.scancode, NO);
+}
+
+- (void)inputUp {
+    if (self.layoutEditing) {
+        return;
+    }
+    if (!self.inputPressed) {
+        return;
+    }
+
+    static const uint32_t minimumPressMilliseconds = 80;
+    const uint32_t elapsed = SDL_GetTicks() - self.inputDownTicks;
+    if (elapsed >= minimumPressMilliseconds) {
+        [self finishInputUp];
+        return;
+    }
+
+    const NSUInteger generation = self.pressGeneration;
+    const uint32_t remaining = minimumPressMilliseconds - elapsed;
+    self.releasePending = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(remaining * NSEC_PER_MSEC)),
+                   dispatch_get_main_queue(), ^{
+                       if (self.pressGeneration == generation) {
+                           [self finishInputUp];
+                       }
+                   });
+}
+
+- (BOOL)accessibilityActivate {
+    if (!self.enabled || self.layoutEditing) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (BOOL)accessibilityHold:(UIAccessibilityCustomAction*)action {
+    if (!self.enabled || self.layoutEditing) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (BOOL)accessibilityDoubleTap:(UIAccessibilityCustomAction*)action {
+    if (!self.enabled || self.layoutEditing) {
+        return NO;
+    }
+
+    [self inputDown];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.20 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputDown];
+                   });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.30 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                       [self inputUp];
+                   });
+    return YES;
+}
+
+- (void)cancelInput {
+    self.pressGeneration += 1;
+    [self finishInputUp];
+}
+
+@end
