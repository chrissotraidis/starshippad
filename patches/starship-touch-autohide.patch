diff --git a/ios/StarshipTouchVisibility.h b/ios/StarshipTouchVisibility.h
new file mode 100644
index 00000000..34ef1757
--- /dev/null
+++ b/ios/StarshipTouchVisibility.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <cstdint>
+
+// Touch-control visibility shared by the overlay, the settings menu and
+// StarshipPad's native tests. libultraship's controller manager stays the
+// authority for which player a controller belongs to.
+namespace StarshipPad {
+
+struct GamepadProfile {
+    bool leftStick = false;
+    bool faceButtons = false; // A, B, X and Y
+    bool start = false;
+};
+
+// A remote or menu-only profile cannot fly, so it never hides the complete
+// touch controller.
+constexpr bool IsGameplayGamepad(const GamepadProfile& profile) {
+    return profile.leftStick && profile.faceButtons && profile.start;
+}
+
+struct TouchPreferences {
+    bool touchControls = true;          // "Touch Controls"; off is the deliberate manual hide
+    bool autoHideWithController = true; // "Auto-hide Touch Controls with Controller"
+};
+
+// "Show Touch Controls" recovers from both kinds of hiding and keeps the
+// controls visible until the user turns auto-hide back on.
+constexpr TouchPreferences ShowTouchControls(TouchPreferences) {
+    return { true, false };
+}
+
+// One policy decides both the artwork and whether the virtual analog
+// controller is attached.
+constexpr bool TouchGameplayControlsVisible(const TouchPreferences& preferences, bool playerOneHasGameplayGamepad) {
+    return preferences.touchControls && !(preferences.autoHideWithController && playerOneHasGameplayGamepad);
+}
+
+// The touch controller's own virtual joystick never counts as a physical
+// controller.
+template <typename Manager, typename ProfileOf>
+bool PlayerOneHasGameplayGamepad(Manager& manager, int32_t touchInstanceId, ProfileOf profileOf) {
+    for (const auto& [instanceId, gamepad] : manager.GetConnectedSDLGamepadsForPort(0)) {
+        if (instanceId != touchInstanceId && IsGameplayGamepad(profileOf(gamepad))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Touch is always player 1's input. The manager would give a virtual joystick
+// attached after a physical controller the next free player, so pin it to
+// player 1 alongside that controller without moving the controller itself.
+template <typename Manager>
+void KeepTouchOnPlayerOne(Manager& manager, int32_t touchInstanceId) {
+    if (touchInstanceId < 0) {
+        return;
+    }
+    manager.UnignoreInstanceIdForPort(0, touchInstanceId);
+    for (uint8_t port = 1; port < 4; port++) {
+        manager.IgnoreInstanceIdForPort(port, touchInstanceId);
+    }
+}
+
+} // namespace StarshipPad
