 void GameEngine::StartFrame() const {
+#ifdef __IOS__
+    {
+        auto manager = this->context->GetControlDeck()->GetConnectedPhysicalDeviceManager();
+        const int32_t touchInstanceId = StarshipPad_GetTouchControllerInstanceId();
+        StarshipPad::KeepTouchOnPlayerOne(*manager, touchInstanceId);
+#if !TARGET_OS_SIMULATOR
+        // Simulator builds skip this: the Simulator always presents its own
+        // wireless MFi "Gamepad", which says nothing about a physical controller.
+        StarshipPad_SetPlayerOneGamepadReady(StarshipPad::PlayerOneHasGameplayGamepad(
+            *manager, touchInstanceId, [](SDL_GameController* gamepad) {
+                return StarshipPad::GamepadProfile{
+                    SDL_GameControllerHasAxis(gamepad, SDL_CONTROLLER_AXIS_LEFTX) &&
+                        SDL_GameControllerHasAxis(gamepad, SDL_CONTROLLER_AXIS_LEFTY),
+                    SDL_GameControllerHasButton(gamepad, SDL_CONTROLLER_BUTTON_A) &&
+                        SDL_GameControllerHasButton(gamepad, SDL_CONTROLLER_BUTTON_B) &&
+                        SDL_GameControllerHasButton(gamepad, SDL_CONTROLLER_BUTTON_X) &&
+                        SDL_GameControllerHasButton(gamepad, SDL_CONTROLLER_BUTTON_Y),
+                    SDL_GameControllerHasButton(gamepad, SDL_CONTROLLER_BUTTON_START) == SDL_TRUE,
+                };
+            }));
+#endif
+    }
+#endif
     using Ship::KbScancode;
     const int32_t dwScancode = this->context->GetWindow()->GetLastScancode();
     this->context->GetWindow()->SetLastScancode(-1);
